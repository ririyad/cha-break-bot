# Copy this file to a file named .env (next to server.js) and fill in ONE option.
# With no key, the demo runs a clearly labelled SIMULATED model (rule-based, no AI)
# that works fully offline.

# --- Option 1 (recommended for the talk): DeepSeek V4.1 Flash via OpenRouter -------
# Create a key at https://openrouter.ai/settings/keys (give it a credit limit, e.g. $2)
#PROVIDER=openrouter
#OPENROUTER_API_KEY=
#MODEL=deepseek/deepseek-v4.1-flash
# Optional speed tweaks to try during rehearsal:
# OPENROUTER_SORT=latency       # prefer the fastest upstream provider ("price" = cheapest)
# REASONING=off                 # ask the model to skip "thinking" for faster replies

# --- Option 2: Google Gemini (free tier, but only a few requests per minute) -------
# Get a key at https://aistudio.google.com/apikey
# PROVIDER=gemini
# GEMINI_API_KEY=
# MODEL=gemini-3.5-flash

# --- Option 3: Anthropic Claude ----------------------------------------------------
# PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# MODEL=claude-haiku-4-5-20251001

# --- Option 4: OpenAI ------------------------------------------------------------------
# PROVIDER=openai
# OPENAI_API_KEY=
# MODEL=gpt-5-mini

# --- Option 5: a local model with Ollama (no internet needed) --------------------------
# PROVIDER=ollama
# MODEL=qwen3:8b                # any Ollama model that supports tools

# --- Option 6: any other OpenAI-compatible server --------------------------------------
# PROVIDER=custom
# BASE_URL=https://example.com/v1
# API_KEY=
# MODEL=

# --- Optional settings -------------------------------------------------------------------
# PORT=3000
# PUBLIC_URL=                   # e.g. a tunnel URL; the QR code will use it
# MODEL_RPM=0                   # max model calls per minute (0 = no limit)
# MAX_CONCURRENT=8              # model calls running at the same time
# QUEUE_TIMEOUT_S=20            # after this wait, the simulated model answers (labelled)
# FALLBACK=simulated            # or "none" to show an error instead
# MAX_ROUNDS=4                  # model rounds per message
# MAX_TOOL_CALLS=6              # tool calls per message
# MAX_MESSAGES_PER_PERSON=25
# STAGE_KEY=                    # fixed presenter key instead of a random one
